// SiteTrack — Construction Cost Tracker
// PostgreSQL via Supabase

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A construction project (one building site)
model Project {
  id          String   @id @default(cuid())
  name        String
  location    String
  description String?
  totalBudget Decimal  @db.Decimal(15, 2)
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  status      String   @default("active") // active, completed, paused
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dailyLogs  DailyLog[]
  materials  Material[]
  laborRoles LaborRole[]
  members    ProjectMember[]
}

// One day's work on one project. Technician submits, engineer approves.
model DailyLog {
  id             String    @id @default(cuid())
  projectId      String
  logDate        DateTime  @db.Date
  technicianName String    @map("engineerName") // column keeps its old name, so no migration
  gpsLat         Decimal?  @db.Decimal(10, 8)
  gpsLng         Decimal?  @db.Decimal(11, 8)
  totalCost      Decimal   @default(0) @db.Decimal(15, 2)
  status         String    @default("draft") // draft, submitted, approved, rejected
  managerNotes   String?
  submittedAt    DateTime?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materials LogMaterial[]
  labor     LogLabor[]

  @@unique([projectId, logDate]) // one log per project per day
}

// Materials used in a daily log
model LogMaterial {
  id         String   @id @default(cuid())
  dailyLogId String
  name       String
  quantity   Decimal  @db.Decimal(10, 2)
  unit       String
  unitCost   Decimal  @db.Decimal(10, 2)
  totalCost  Decimal  @db.Decimal(12, 2)
  photoUrls  String[] // receipt photos in Supabase Storage
  notes      String?
  createdAt  DateTime @default(now())

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
}

// Labor logged in a daily log
model LogLabor {
  id            String   @id @default(cuid())
  dailyLogId    String
  roleName      String
  workerCount   Int
  hoursWorked   Decimal  @db.Decimal(4, 1)
  hourlyRate    Decimal  @db.Decimal(8, 2)
  totalCost     Decimal  @db.Decimal(12, 2)
  overtimeHours Decimal? @db.Decimal(4, 1)
  overtimeRate  Decimal? @db.Decimal(8, 2)
  createdAt     DateTime @default(now())

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
}

// Preset catalog of materials for a project (technician picks, doesn't type)
model Material {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  category    String
  defaultUnit String
  defaultCost Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Preset catalog of labor roles for a project (Albanian-market wages)
model LaborRole {
  id                 String   @id @default(cuid())
  projectId          String
  name               String
  skillLevel         Int // 1, 2, 3
  baseHourlyRate     Decimal  @db.Decimal(8, 2)
  overtimeMultiplier Decimal  @default(1.5)
  createdAt          DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// A person who can log in. The id is their Supabase Auth user id (auth.users.id).
// Role and status live here — never in Supabase user_metadata, which users can edit.
model Profile {
  id          String   @id @db.Uuid
  email       String   @unique
  name        String
  role        String // owner, engineer, technician
  status      String   @default("invited") // invited, active, deactivated
  invitedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  memberships ProjectMember[]
}

// Which projects a person works on — picked by whoever added them.
model ProjectMember {
  profileId String   @db.Uuid
  projectId String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([profileId, projectId])
}
